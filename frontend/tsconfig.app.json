{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": [],
    "module": "ES2020",  
    "target": "ES2020",
    "esModuleInterop": true, 
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "moduleResolution": "Node",  
    "lib": ["ES2020", "DOM"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
